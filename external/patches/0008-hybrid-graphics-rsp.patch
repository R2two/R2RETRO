+        *dmem_u32(&g_hle, TASK_UCODE_BOOT_SIZE) <= 0x1000 &&
+        code <= 0x800000 - 4096 && data <= 0x800000 - 2048 &&
+        list && !(list & 7) && list < 0x800000 && !(bytes & 7) &&
+        bytes <= 0x800000 - list && l_ProcessDlistList &&
