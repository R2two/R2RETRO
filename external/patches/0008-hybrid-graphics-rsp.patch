 EXPORT unsigned int CALL hleDoRspCycles(unsigned int Cycles)
 {
-    hle_execute(&g_hle);
-    return Cycles;
+    uint32_t code, data, list, bytes;
+    int graphics;
+    if (!r2n64_hybrid_ready) return 0;
+    if (*g_hle.sp_status & (SP_STATUS_HALT | SP_STATUS_BROKE)) return 0;
+    graphics = *dmem_u32(&g_hle, TASK_TYPE) == 1;
+    code = *dmem_u32(&g_hle, TASK_UCODE) & 0x1fffffff;
+    data = *dmem_u32(&g_hle, TASK_UCODE_DATA) & 0x1fffffff;
+    list = *dmem_u32(&g_hle, TASK_DATA_PTR) & 0x1fffffff;
+    bytes = *dmem_u32(&g_hle, TASK_DATA_SIZE);
