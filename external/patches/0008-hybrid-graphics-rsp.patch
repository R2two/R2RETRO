+
+// Conservative, read-only admission before the hybrid RSP changes SP state.
+// Unknown/custom text signatures retain CXD4. Never infer support from a ROM title.
+extern "C" int gln64R2KnownGraphicsTask(unsigned int code, unsigned int data)
+{
+    if (!RDRAM || code > 0x800000 - 4096 || data > 0x800000 - 2048)
+        return 0;
+    const u32 crc = CRC_Calculate_Strict(0xFFFFFFFF, &RDRAM[code], 4096);
+    for (const auto& info : specialMicrocodes)
+        if (info.crc == crc) return 1;
+    char text[2048];
+    UnswapCopyWrap(RDRAM, data, (u8*)text, 0, 0x7FF, sizeof(text));
+    for (size_t i = 0; i + 3 < sizeof(text); ++i) {
+        if (memcmp(text + i, "RSP", 3) != 0) continue;
+        size_t n = 0;
+        while (i + n < sizeof(text) && n < 255 &&
+               static_cast<unsigned char>(text[i+n]) > 10) ++n;
+        // This first text-only profile covers the Zelda OoT F3DZEX family
+        // recognized by the parser below. Other families require validation.
+        return i+n < sizeof(text) && n >= 35 && n < 255 &&
+               memcmp(text+i+4, "Gfx", 3) == 0 &&
+               memcmp(text+i+14, "F3DZEX", 6) == 0 && text[i+34] == '6';
+    }
+    return 0;
+}
 
