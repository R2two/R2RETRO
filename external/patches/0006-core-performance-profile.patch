@@ -0,0 +1,17 @@
+#ifndef R2N64_PROFILE_INTERNAL_H
+#define R2N64_PROFILE_INTERNAL_H
+#include "core_profile.h"
+
+enum r2n64_profile_component {
+    R2N64_PROFILE_RSP,
+    R2N64_PROFILE_RDP,
+    R2N64_PROFILE_SCANOUT,
+    R2N64_PROFILE_AUDIO_HLE
+};
+
+/* All calls stay on the emulation/frontend thread, including libco switches. */
+void r2n64_profile_run_begin(void);
+void r2n64_profile_run_end(void);
+uint64_t r2n64_profile_enter(enum r2n64_profile_component component);
+void r2n64_profile_leave(uint64_t token);
+#endif
--- /dev/null
+++ b/libretro/r2n64_profile.c
@@ -0,0 +1,129 @@
+/* R2N64 coarse dispatch profiler. Disabled by default; no per-op timing. */
+#include "r2n64_profile.h"
+#include <libretro.h>
+#if defined(__PS4__)
+#include <orbis/libkernel.h>
+#else
+#include <features/features_cpu.h>
+#endif
+#include <string.h>
+
+#define PROFILE_STACK_CAPACITY 16u
+static R2N64CoreProfile result;
+static enum r2n64_profile_component stack[PROFILE_STACK_CAPACITY];
+static uint32_t generation = 1;
+static unsigned depth;
+static int enabled, running;
+static uint64_t last_tick, run_start, clock_floor;
+
+static uint64_t profile_now(void)
+{
+#if defined(__PS4__)
+    /* Native monotonic microseconds, matching upstream's ORBIS timer branch.
+     * PacBrew's POSIX CLOCK_MONOTONIC numeric ID cannot be assumed to match
+     * libkernel's exported clock_gettime ABI, so avoid that ID translation. */
+    const retro_time_t value = (retro_time_t)sceKernelGetProcessTime();
+#else
+    const retro_time_t value = cpu_features_get_time_usec();
+#endif
+    if (value <= 0 || (uint64_t)value < clock_floor) {
+        ++result.timer_failures;
+        return clock_floor;
+    }
+    clock_floor = (uint64_t)value;
+    return clock_floor;
+}
+
+static void charge(uint64_t now)
+{
+    const uint64_t elapsed = now >= last_tick ? now - last_tick : 0;
+    if (running && depth) {
+        switch (stack[depth - 1]) {
+        case R2N64_PROFILE_RSP: result.rsp_us += elapsed; break;
+        case R2N64_PROFILE_RDP: result.rdp_us += elapsed; break;
+        case R2N64_PROFILE_SCANOUT: result.scanout_us += elapsed; break;
+        case R2N64_PROFILE_AUDIO_HLE: result.audio_hle_us += elapsed; break;
+        }
+    }
+    last_tick = now;
+}
+
+RETRO_API void retro_r2n64_profile_reset(void)
+{
+    memset(&result, 0, sizeof(result));
+    result.abi_version = R2N64_CORE_PROFILE_ABI;
+    result.struct_size = sizeof(result);
+    depth = 0;
+    running = 0;
+    run_start = last_tick = clock_floor = 0;
+    if (++generation == 0) generation = 1;
+}
+
+RETRO_API void retro_r2n64_profile_set_enabled(int value)
+{
+    enabled = value != 0;
+    retro_r2n64_profile_reset();
+}
+
+RETRO_API void retro_r2n64_profile_read(R2N64CoreProfile* snapshot)
+{
+    if (!snapshot) return;
+    *snapshot = result;
+    snapshot->abi_version = R2N64_CORE_PROFILE_ABI;
+    snapshot->struct_size = sizeof(*snapshot);
+}
+
+void r2n64_profile_run_begin(void)
+{
+    uint64_t failures;
+    if (!enabled) return;
+    failures = result.timer_failures;
+    run_start = last_tick = profile_now();
+    /* Never use an earlier run's clock floor as the opening timestamp: that
+     * would charge the intervening frontend pause when this read fails. */
+    running = run_start != 0 && result.timer_failures == failures;
+}
+
+void r2n64_profile_run_end(void)
+{
+    uint64_t now;
+    if (!enabled || !running) return;
+    now = profile_now();
+    charge(now);
+    result.run_us += now - run_start;
+    ++result.run_calls;
+    running = 0;
+    /* Keep an enclosing scope suspended across libco yield. Its next charged
+     * interval starts at run_begin, so all external idle time is excluded. */
+}
+
+uint64_t r2n64_profile_enter(enum r2n64_profile_component component)
+{
+    uint64_t now;
+    if (!enabled || !running) return 0;
+    if (depth == PROFILE_STACK_CAPACITY || component > R2N64_PROFILE_AUDIO_HLE) {
+        ++result.dropped_scopes;
+        return 0;
+    }
+    now = profile_now();
+    charge(now);
+    stack[depth++] = component;
+    switch (component) {
+    case R2N64_PROFILE_RSP: ++result.rsp_calls; break;
+    case R2N64_PROFILE_RDP: ++result.rdp_calls; break;
+    case R2N64_PROFILE_SCANOUT: ++result.scanout_calls; break;
+    case R2N64_PROFILE_AUDIO_HLE: ++result.audio_hle_calls; break;
+    }
+    return ((uint64_t)generation << 32) | depth;
+}
+
+void r2n64_profile_leave(uint64_t token)
+{
+    if (!token || !enabled || (uint32_t)(token >> 32) != generation) return;
+    if (!depth || (uint32_t)token != depth) {
+        ++result.dropped_scopes;
+        return;
+    }
+    if (running) charge(profile_now());
+    --depth;
+}
